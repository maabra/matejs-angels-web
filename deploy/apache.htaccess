# Install as .htaccess beside index.html on the matejsangels.com Apache host.
# GitHub Pages does not process this file. No external-host upload is automatic.
Options -MultiViews
DirectoryIndex index.html
AddDefaultCharset UTF-8
RewriteEngine On

# Consolidate www URLs onto the HTTPS, non-www canonical host.
RewriteCond %{HTTP_HOST} ^www\.matejsangels\.com$ [NC]
RewriteRule ^ https://matejsangels.com%{REQUEST_URI} [R=301,L,NE]

# Accommodate hosts which terminate HTTPS at a reverse proxy.
RewriteCond %{HTTP_HOST} ^matejsangels\.com$ [NC]
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !^https$ [NC]
RewriteRule ^ https://matejsangels.com%{REQUEST_URI} [R=301,L,NE]

# The former blog listing is an alias of the news page.
RewriteRule ^hr/blog(?:\.html)?/?$ /hr/vijesti [R=301,L]

# Redirect requested HTML filenames, not internal extensionless rewrites.
RewriteCond %{THE_REQUEST} \s/+[^?\s]*index\.html(?:[?\s]) [NC]
RewriteRule ^(.*)index\.html$ /$1 [R=301,L]
RewriteCond %{THE_REQUEST} \s/+[^?\s]+\.html(?:[?\s]) [NC]
RewriteRule ^(.+)\.html$ /$1 [R=301,L]

RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [END]
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.+)$ $1.html [END]

<IfModule mod_headers.c>
  <FilesMatch "\.(html|js|css)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>
